{
  "name": "dax",
  "version": "0.1.0",
  "description": "Desktop app that mirrors a filesystem as 3D objects in a physics-based environment with an autonomous AI agent",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "build": "electron-forge make",
    "package": "electron-forge package",
    "lint": "eslint src/ test/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babylonjs/core": "^7.0.0",
    "@babylonjs/gui": "^7.54.3",
    "@babylonjs/havok": "^1.3.11",
    "@tursodatabase/database": "^0.5.0",
    "chokidar": "^5.0.0",
    "d3-force": "^3.0.0",
    "drizzle-orm": "^0.45.1",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-deb": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@types/d3-force": "^3.0.10",
    "electron": "^33.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
